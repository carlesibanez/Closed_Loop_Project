<?xml version="1.0"?>
<robot name="microplate">
  <link name="microplate_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://closed_loop_dalsa_description/meshes/Greiner_microplate.stl" scale="1 1 1"/>
      </geometry>
      <material name="white">
        <color rgba="0.8 0.8 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0075" rpy="0 0 0"/>
      <geometry>
        <box size="0.127 0.085 0.015"/> 
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/> <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="aruco">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://closed_loop_dalsa_description/meshes/aruco-42.obj" scale="1 1 1"/>
      </geometry>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.001"/> 
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/> <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="microplate_to_aruco" type="fixed">
    <parent link="microplate_link"/>
    <child link="aruco"/>
    <origin xyz="0 0 0.015" rpy="0 0 0"/>
  </joint>

</robot>